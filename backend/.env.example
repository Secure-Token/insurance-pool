
# ==========================================
# ST INSURANCE POOL - ENVIRONMENT CONFIG
# ==========================================

# Application
APP_NAME=ST-Insurance-Pool
APP_ENV=development
APP_DEBUG=true

# Database
DATABASE_URL=sqlite:///./st_pool.db

# ==========================================
# LLM CONFIGURATION - OLLAMA
# ==========================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=120
MODEL_CONFIDENCE_THRESHOLD=0.70

# ==========================================
# EVALUATION ENGINE
# ==========================================

EVALUATION_MODE=llm_assisted
MODEL_MAX_RETRIES=2
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=2048

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO
